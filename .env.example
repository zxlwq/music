# =============================================================================
# Music Player 环境变量示例
# =============================================================================
# 复制为 .env 后填入真实值（勿提交 .env 到 Git）：
#   cp .env.example .env
#
# 本地 `npm start` / `npm run dev` 会自动读取项目根目录 `.env`（不覆盖 Shell 已有变量）。
# Docker Compose 也会读取 `.env`；Cloudflare / Vercel 等在平台控制台配置同名变量。
# =============================================================================

# 服务（可选，默认 3000）
PORT=3000

# GitHub 仓库（必需：上传 / 删除 / 导入等）
GIT_REPO=用户名/仓库名
GIT_BRANCH=main
GIT_TOKEN=github-token
GIT_URL=https://proxy.example.com

# 管理员密码（必需：删除歌曲验证）
PASSWORD=password

# WebDAV（可选）
WEBDAV_URL=https://dav.example.com/path
WEBDAV_USER=用户名
WEBDAV_PASS=密码
WEBDAV_PATH=music

# Cloudflare R2（可选）
ACCOUNT_ID=你的R2账户ID
ACCESS_KEY_ID=你的R2访问密钥ID
SECRET_ACCESS_KEY=你的R2秘密访问密钥

# Upstash Redis（可选，非 Cloudflare KV 部署时使用）
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=你的_upstash_令牌

# Cloudflare KV：在 Pages 控制台绑定，Variable name 填 KV（不在此填写）
