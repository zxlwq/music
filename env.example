# 环境变量示例（与 .env.example 保持一致）
# 复制为 .env 后填入真实值：cp .env.example .env
# 本地 npm start / npm run dev 会自动读取 .env
# 用于上传歌曲到GitHub仓库
GIT_REPO=用户名/仓库名
GIT_BRANCH=main（可选）
GIT_TOKEN=github-token
GIT_URL=https://proxy.example.com （可选，GitHub代理）

# 管理员密码（必需）
# 删除歌曲时必须输入此密码进行验证
PASSWORD=password

# WebDAV（可选，用于云盘上传/恢复）
WEBDAV_URL=https://dav.example.com/path
WEBDAV_USER=用户名
WEBDAV_PASS=密码
WEBDAV_PATH=music（可选，WebDAV云盘中音乐文件夹路径，默认为music）

# Cloudflare R2 配置（可选，用于切换到R2歌单）
ACCOUNT_ID=你的R2账户ID
ACCESS_KEY_ID=你的R2访问密钥ID
SECRET_ACCESS_KEY=你的R2秘密访问密钥

# Upstash Redis（可选，非 Cloudflare KV 部署时使用）
# 与 GitHub Gist 双写收藏/音频缓存文档；读优先 Redis，失败回退 Gist
# 在 Upstash 控制台创建数据库后复制 REST URL 与 TOKEN
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=你的_upstash_令牌

# Cloudflare KV（不在此文件填写：在 Pages 项目里「绑定」命名空间）
# 绑定名称必须为 KV（与 Workers env.KV 一致）；绑定后 /api/gist 仅使用 KV 持久化，不访问 Gist
# 路径：Pages 项目 → Settings → Functions → KV namespace bindings → Variable name 填 KV

