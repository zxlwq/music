{
  "name": "music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate.mjs",
    "predev": "node scripts/generate.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"node server.js\" \"vite --strictPort\"",
    "build": "vite build && node scripts/precache.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "node server.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:style": "stylelint \"src/**/*.css\" \"public/**/*.css\"",
    "lint:style:fix": "stylelint \"src/**/*.css\" \"public/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json",
    "check": "npm run lint && npm run format:check && npm run lint:style && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@upstash/redis": "^1.34.3",
    "compression": "^1.7.4",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.5",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.1.9"
  }
}
